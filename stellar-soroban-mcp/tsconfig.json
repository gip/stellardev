{
    "compilerOptions": {
    "esModuleInterop": true,
    "target": "ES2015",
    "strict": true,
    "lib": ["ES2015", "DOM"],
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "outDir": "./dist",
      "rootDir": ".",
      "moduleResolution": "NodeNext",
      "module": "NodeNext"
    },
    "include": [
      "./**/*.ts"
    ]
  }